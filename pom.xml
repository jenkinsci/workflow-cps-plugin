<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2250.va_d01d559a_209</version>
    <relativePath />
  </parent>
  <groupId>org.jenkins-ci.plugins.workflow</groupId>
  <artifactId>workflow-cps-parent</artifactId>
  <version>${changelist}</version>
  <packaging>pom</packaging>
  <name>Pipeline: Groovy Parent</name>
  <url>https://github.com/jenkinsci/workflow-cps-plugin</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <modules>
    <module>dgm-builder</module>
    <module>lib</module>
    <module>plugin</module>
  </modules>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
    <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>
  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/${project.artifactId}-plugin</gitHubRepo>
    <!-- https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/ -->
    <jenkins.baseline>2.568</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
    <!-- TODO: Add org.codehaus.groovy:groovy and org.codehaus.groovy:groovy:sources to Jenkins core BOM so this can be deleted? (currently it only specifies groovy-all) -->
    <groovy.version>2.4.21</groovy.version>
    <spotless.check.skip>false</spotless.check.skip>
  </properties>
  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>display-info</id>
            <inherited>false</inherited>
            <configuration>
              <rules>
                <!--
                  plugin-pom configures enforceBytecodeVersion with maxJdkVersion=${maven.compiler.release},
                  defaulting to 17. For hpi-packaged modules, maven-hpi-plugin's ValidateMojo dynamically
                  updates maven.compiler.release based on the core version
                  (https://github.com/jenkinsci/maven-hpi-plugin/pull/323) and skips enforceBytecodeVersion
                  on first invocation until that takes effect
                  (https://github.com/jenkinsci/maven-hpi-plugin/pull/583).
                  However, ValidateMojo is only bound to hpi packaging via HpiLifecycleMappingProvider
                  (@Named("hpi")), so it never runs for this pom-packaged parent. As a result,
                  maven.compiler.release stays at 17 and enforceBytecodeVersion fails against
                  dependencies that now ship JDK 21 bytecode.
                  Disable the rule at this level only; child hpi modules are unaffected.
                -->
                <enforceBytecodeVersion>
                  <ignoreClasses>
                    <ignoreClass>*</ignoreClass>
                  </ignoreClasses>
                </enforceBytecodeVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
